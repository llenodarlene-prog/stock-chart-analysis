# Copy to backend/.env and fill in. Never commit .env.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Free plan: iex is the only feed available without a subscription.
ALPACA_FEED=iex
# Trading API host used only for the asset list (symbol search). Paper keys use the paper host.
ALPACA_TRADING_HOST=https://paper-api.alpaca.markets
DATABASE_PATH=data/market.sqlite3
